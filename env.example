# Mailbox that receives the requests
IMAP_SERVER=imap.example.com
IMAP_USER=reservations@example.com
IMAP_PASSWORD=change-me

# Outgoing mail
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=reservations@example.com
SMTP_PASSWORD=change-me
FROM_EMAIL=reservations@example.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Only send real emails when this is "true" (default: dry run)
SEND_EMAILS=false

# PostgreSQL connection string
DB_URL=postgresql://user:password@host:5432/dbname

# LLM extraction
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-3.5-turbo
